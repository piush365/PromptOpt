# Copy to .env and fill in real values. .env is git-ignored; this file is committed.
# Every line is optional: the optimizer (Stage A + B, the web app, the demo, the tests) runs without any of them.

# Database. Leave DATABASE_URL unset to use SQLite at backend/promptopt.db.
# DATABASE_URL=postgresql+psycopg://promptopt:CHANGE_ME@localhost:5432/promptopt
# Tests DROP ALL TABLES here: must point at promptopt_test only.
# TEST_POSTGRES_URL=postgresql+psycopg://promptopt:CHANGE_ME@localhost:5432/promptopt_test
# RETENTION_DAYS=30
# SQL_ECHO=0

# LLM API keys (Compare in the app, evaluation harness). Free tiers; usage stays within 70% of each daily limit.
# Groq: https://console.groq.com/keys    Cerebras: https://cloud.cerebras.ai    Gemini: https://aistudio.google.com/apikey
# GROQ_API_KEY=CHANGE_ME
# CEREBRAS_API_KEY=CHANGE_ME
# GEMINI_API_KEY=CHANGE_ME
# GEMINI_MODEL=gemini-2.5-flash

# Password for visitors from OTHER machines when the app is reachable on a network (HTTP Basic auth, any user name).
# There are no user accounts: without it anyone who can reach the app sees all History and can spend the Compare quota.
# Requests from this machine never need it.
# PROMPTOPT_PASSWORD=CHANGE_ME

# Stage C (LoRA). Used when the adapter exists and transformers/peft are installed (backend/.venv-gpu).
# STAGE_C_ENABLED=1                                  # 0 = Stage A + B only, even if Stage C is available
# STAGE_C_ADAPTER=artifacts/stage_c_adapter
# STAGE_C_DEVICE=auto                                # auto = cuda if available, else cpu

# Dataset (not in the repo; see README "Dataset and Stage C adapter"). Default: ../data/promptopt_dataset_v1_2_final
# DATASET_DIR=../data/promptopt_dataset_v1_2_final

# Coding sandbox: refuse to run generated code without bubblewrap (default 1; 0 only for local experiments)
# SANDBOX_REQUIRE_BWRAP=1
