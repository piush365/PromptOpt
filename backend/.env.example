# Copy to .env and fill in real values. .env is git-ignored; this file is committed.
# Leave DATABASE_URL unset to use SQLite (sqlite:///./promptopt.db).
DATABASE_URL=postgresql+psycopg://promptopt:CHANGE_ME@localhost:5432/promptopt
# Tests DROP ALL TABLES here: must point at promptopt_test only.
TEST_POSTGRES_URL=postgresql+psycopg://promptopt:CHANGE_ME@localhost:5432/promptopt_test
# RETENTION_DAYS=30
# SQL_ECHO=0
